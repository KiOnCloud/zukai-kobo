sequenceDiagram
  %% id: web
  participant n1 as Web shop
  %% id: api
  participant n2 as Order service
  %% id: db
  participant n3 as Order database
  %% id: psp
  participant n4 as Payment provider
  %% id: m1
  n1->>n2: POST /orders
  %% id: b1
  loop up to 3 attempts
    %% id: m2
    n2->>n4: Authorize card payment for the order total
    %% id: m3
    n4-->>n2: authorized
  end
  %% id: b2
  alt authorized
    %% id: m4
    n2-->>n1: 201 Created
  else declined after 3 attempts
    %% id: m5
    n2-->>n1: 402 Payment Required
  end
