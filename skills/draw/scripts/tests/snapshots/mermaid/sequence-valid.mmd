---
title: "Login with password"
---
sequenceDiagram
  %% id: user
  actor n1 as User
  %% id: web
  participant n2 as Web app
  %% id: auth
  participant n3@{ "type" : "control" } as Auth service
  %% id: db
  participant n4@{ "type" : "database" } as User DB
  %% id: b2
  loop until 3 attempts
    %% id: m1
    n1->>n2: Submit credentials
    %% id: n1
    Note right of n2: Rate limited per IP
    %% id: m2
    n2->>n3: POST /login
    %% id: m3
    n3->>n4: SELECT user by email
    %% id: m4
    n4-->>n3: user row
    %% id: m5
    n3->>n3: Verify password hash
    %% id: n2
    Note over n3,n4: Hash: argon2id
    %% id: b1
    alt password matches
      %% id: m6
      n3-->>n2: 200 session token
      %% id: m7
      n2-->>n1: Redirect to dashboard
    else password wrong
      %% id: m8
      n3-->>n2: 401 invalid credentials
      %% id: m9
      n2-->>n1: Show error
    end
  end
  %% id: m10
  n2-)n3: Audit login attempt
