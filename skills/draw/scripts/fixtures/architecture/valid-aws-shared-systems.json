{
  "schemaVersion": 1,
  "kind": "architecture",
  "title": "Booking platform on AWS",
  "direction": "LR",
  "components": [
    { "id": "browser", "label": "Staff browser", "kind": "client" },
    { "id": "cdn", "label": "CloudFront", "icon": "aws:cloudfront" },
    { "id": "site", "label": "S3 web app", "kind": "database", "icon": "aws:s3" },
    { "id": "alb", "label": "Application Load Balancer", "icon": "aws:elastic_load_balancing" },
    { "id": "api", "label": "Booking API (ECS Fargate)", "icon": "aws:fargate" },
    { "id": "tables", "label": "DynamoDB", "kind": "database", "icon": "aws:dynamodb" },
    { "id": "files", "label": "S3 attachments", "kind": "database", "icon": "aws:s3" },
    { "id": "idp", "label": "Identity provider", "kind": "external", "icon": "aws:generic_application" },
    { "id": "realtime", "label": "Firebase Realtime Database", "kind": "external", "icon": "gcp:firebase" },
    { "id": "client_logs", "label": "Client log collector", "kind": "external", "icon": "aws:generic_application" }
  ],
  "boundaries": [
    { "id": "account", "label": "Production account", "group": "aws:aws_account", "children": ["cdn", "region"] },
    { "id": "region", "label": "ap-northeast-1 (Tokyo)", "group": "aws:region", "children": ["site", "vpc", "tables", "files"] },
    { "id": "vpc", "label": "VPC", "group": "aws:vpc", "children": ["public", "private"] },
    { "id": "public", "label": "Public subnets", "group": "aws:public_subnet", "children": ["alb"] },
    { "id": "private", "label": "Private subnets", "group": "aws:private_subnet", "children": ["api"] }
  ],
  "connections": [
    { "id": "c1", "from": "browser", "to": "cdn", "label": "HTTPS" },
    { "id": "c2", "from": "browser", "to": "alb", "label": "REST" },
    { "id": "c3", "from": "browser", "to": "idp", "label": "sign in" },
    { "id": "c4", "from": "browser", "to": "realtime", "label": "listen for version" },
    { "id": "c5", "from": "browser", "to": "client_logs", "label": "client logs" },
    { "id": "c6", "from": "cdn", "to": "site" },
    { "id": "c7", "from": "alb", "to": "api", "label": "HTTP" },
    { "id": "c8", "from": "api", "to": "tables", "label": "read / write" },
    { "id": "c9", "from": "api", "to": "files", "label": "store files" },
    { "id": "c10", "from": "api", "to": "idp", "label": "verify token" },
    { "id": "c11", "from": "api", "to": "realtime", "label": "publish version" }
  ]
}
