{
  "schemaVersion": 1,
  "kind": "architecture",
  "title": "Invoicing on Google Cloud: the topic pushes back to the API",
  "direction": "LR",
  "meta": {
    "source": "manual",
    "notes": ["A circle through a topic: the API publishes to it, and a second subscription pushes the status back to the API. The connection that closes the circle is listed last."],
