{
  "schemaVersion": 1,
  "kind": "architecture",
  "title": "Web tier across two zones",
  "components": [
    { "id": "users", "label": "Users", "kind": "client" },
    { "id": "dns", "label": "Cloud DNS", "icon": "gcp:cloud_dns" },
    { "id": "lb", "label": "Application Load Balancer", "icon": "gcp:cloud_load_balancing" },
    { "id": "web_a", "label": "Web server A", "icon": "gcp:compute_engine" },
    { "id": "web_c", "label": "Web server C", "icon": "gcp:compute_engine" },
    { "id": "db_primary", "label": "Cloud SQL primary", "kind": "database", "icon": "gcp:cloud_sql" },
    { "id": "db_standby", "label": "Cloud SQL standby (HA)", "kind": "database", "icon": "gcp:cloud_sql" },
    { "id": "secrets", "label": "Secret Manager" },
    { "id": "erp", "label": "On-premise ERP", "kind": "external" },
    { "id": "batch", "label": "Nightly export job" }
  ],
  "boundaries": [
    { "id": "project", "label": "Production project", "group": "gcp:project", "children": ["dns", "vpc", "secrets"] },
    { "id": "vpc", "label": "VPC network", "group": "gcp:vpc_network", "children": ["lb", "mig", "data"] },
    { "id": "mig", "label": "Managed instance group", "group": "gcp:instance_group", "children": ["zone_a", "zone_c"] },
    { "id": "zone_a", "label": "Zone asia-northeast1-a", "group": "gcp:zone", "children": ["web_a"] },
    { "id": "zone_c", "label": "Zone asia-northeast1-c", "group": "gcp:zone", "children": ["web_c"] },
    { "id": "data", "label": "Database firewall rule", "group": "gcp:firewall", "children": ["db_primary", "db_standby"] },
    { "id": "dc", "label": "Corporate data center", "children": ["erp", "batch"] }
  ],
  "connections": [
    { "id": "c1", "from": "users", "to": "dns", "label": "DNS" },
    { "id": "c2", "from": "users", "to": "lb", "label": "HTTPS" },
    { "id": "c3", "from": "lb", "to": "web_a" },
    { "id": "c4", "from": "lb", "to": "web_c" },
    { "id": "c5", "from": "web_a", "to": "db_primary", "label": "SQL" },
    { "id": "c6", "from": "web_c", "to": "db_primary", "label": "SQL" },
    { "id": "c7", "from": "db_primary", "to": "db_standby", "label": "replication", "bidirectional": true },
    { "id": "c8", "from": "web_a", "to": "secrets", "label": "read secret" },
    { "id": "c9", "from": "batch", "to": "db_standby", "label": "read replica" },
    { "id": "c10", "from": "batch", "to": "erp", "label": "export" }
  ]
}
